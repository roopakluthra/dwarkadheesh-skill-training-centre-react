# Copy this file to .env and fill in real values before deploying.

PORT=5000

# Website contact email (where enquiry/admission notifications should be sent)
NOTIFY_EMAIL=preet@dwarkadheeshpolytechnic.online

# SMTP credentials used to SEND the notification email.
# If left blank, the server will still accept and store enquiries —
# it just won't be able to email a notification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Comma-separated list of origins allowed to call this API in production
# e.g. https://www.dwarkadheeshpolytechnic.online
CORS_ORIGIN=http://localhost:5173
